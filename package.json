{
  "name": "portfolio-api",
  "version": "1.0.0",
  "description": "API Fastify em TypeScript para portfolio com criação de usuário, permissões e login JWT.",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "check": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev --name init"
  },
  "author": "andré pieresan",
  "license": "MIT",
  "dependencies": {
    "@fastify/jwt": "^10.0.0",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
